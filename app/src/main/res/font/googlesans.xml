<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Regular -->
    <font
        android:font="@font/googlesans_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/googlesans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <!-- Italic -->
    <font
        android:font="@font/googlesans_italic"
        android:fontStyle="italic"
        android:fontWeight="400"
        app:font="@font/googlesans_italic"
        app:fontStyle="italic"
        app:fontWeight="400" />

    <!-- Medium -->
    <font
        android:font="@font/googlesans_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/googlesans_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <!-- Bold -->
    <font
        android:font="@font/googlesans_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/googlesans_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

</font-family>
